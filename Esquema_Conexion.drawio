        <mxCell id="c132" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#000000;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;KM3  Contactor estrella (Y)&lt;br&gt;Siemens 3RT2016 · bobina 230 V AC&lt;/font&gt;" vertex="1">
