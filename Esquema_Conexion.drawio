        <mxCell id="c134" edge="1" parent="1" style="html=1;rounded=0;endArrow=none;endFill=1;startArrow=none;startFill=1;strokeColor=#666666;strokeWidth=1.2;dashed=1;" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
