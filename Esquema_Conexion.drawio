        </mxCell>
        <mxCell id="c133" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=8;fontColor=#666666;fontFamily=Helvetica;spacing=0;spacingLeft=2;spacingRight=2;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;punto neutro Y&lt;/font&gt;" vertex="1">
